{
  "name": "dsh-token-speed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "token 速度实时显示",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
